{
  "name": "shana-agent",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "shana": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-assets.mjs",
    "dev": "tsx src/main.ts",
    "test": "npm run test:application && npm run test:framework",
    "test:framework": "node --test --test-concurrency=2 --test-reporter=dot tests/tui/framework/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:application": "node run-application-tests.mjs"
  },
  "prettier": {
    "printWidth": 110
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@vscode/ripgrep": "^1.18.0",
    "get-east-asian-width": "1.6.0",
    "globby": "^16.2.4",
    "highlight.js": "11.11.2",
    "marked": "18.0.11",
    "marked-cjk-friendly": "0.1.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@xterm/headless": "5.5.0",
    "chalk": "6.0.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^5.1.0"
  }
}
